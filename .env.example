# =============================================================================
# WXN Chatbot - variaveis de ambiente (exemplo)
#
# Copie o que precisar para o lugar certo - este arquivo e so documentacao,
# nada aqui e lido automaticamente:
#
#   - Backend (Spring Boot): SPRING_PROFILES_ACTIVE seleciona `dev` para
#     desenvolvimento ou `prod` no deploy. Valores locais ficam em
#     backend/src/main/resources/application-dev.properties; configure os
#     valores reais de producao no ambiente da plataforma de hospedagem.
#
#   - Frontend (Vite): copie a secao "Frontend" para frontend/.env
#     (o Vite le esse arquivo automaticamente). Ha um frontend/.env.example
#     dedicado com o mesmo conteudo.
#
# NUNCA commite um arquivo .env com valores reais. Apenas este .env.example
# (com placeholders) deve ir para o Git.
# =============================================================================

# -----------------------------------------------------------------------------
# Backend - banco de dados PostgreSQL
# -----------------------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/wxn_chatbot
DB_USER=wxn_user
DB_PASSWORD=wxn_password

# -----------------------------------------------------------------------------
# Backend - servidor, perfil e integracao com o frontend
# -----------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
WXN_API_BASE_URL=http://localhost:8080/mock/wxn

# -----------------------------------------------------------------------------
# Frontend - URL do backend que o React vai consumir
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Backend - chat e IA (Lily). Veja docs/chatbot-lily.md.
# CHATBOT_LLM=fake (padrao) usa palavras-chave e textos prontos, sem gastar cota.
# CHATBOT_LLM=gemini liga a Gemini. A chave e pessoal: crie a sua no Google AI
# Studio e preencha so no seu ambiente local (ou como segredo na plataforma de
# deploy). NUNCA commite uma chave real.
# -----------------------------------------------------------------------------
CHATBOT_LLM=fake
GEMINI_API_KEY=
# A API de chat nao tem autenticacao: fica ligada em dev e desligada em prod.
CHAT_API_HABILITADA=true

# -----------------------------------------------------------------------------
# Backend - WhatsApp (Cloud API da Meta). Desligado por padrao; veja
# docs/whatsapp.md antes de ligar. Os valores reais ficam so no ambiente.
# -----------------------------------------------------------------------------
WHATSAPP_HABILITADO=false

# -----------------------------------------------------------------------------
# Reservado para etapas futuras (nao usado hoje; a IA atual e a Gemini).
# Deixe em branco neste repositorio.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
